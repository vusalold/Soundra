<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Sonic Glow -->
    <path
        android:pathData="M54,54m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="40">
                <item android:offset="0.15" android:color="#3500FFF0" />
                <item android:offset="0.65" android:color="#157F00FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Equalizer Left Waveform -->
    <group>
        <path
            android:pathData="M20,51 L20,57"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeColor="#5000FFF0" />
        <path
            android:pathData="M24,44 L24,64"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeColor="#9000FFF0" />
        <path
            android:pathData="M28,47 L28,61"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeColor="#D000C8FF" />
    </group>

    <!-- Equalizer Right Waveform -->
    <group>
        <path
            android:pathData="M80,47 L80,61"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeColor="#D09B00FF" />
        <path
            android:pathData="M84,44 L84,64"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeColor="#90C400FF" />
        <path
            android:pathData="M88,51 L88,57"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeColor="#50FF007F" />
    </group>

    <!-- Main Soundra 'S' Sonic Wave Ribbon -->
    <path
        android:pathData="M66,28 C56,21 42,22 36,30 C30,38 32,48 43,53 L65,61 C76,66 78,76 72,84 C66,92 50,93 40,86"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="36"
                android:startY="24"
                android:endX="72"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFF0" />
                <item android:offset="0.45" android:color="#0088FF" />
                <item android:offset="0.75" android:color="#9900FF" />
                <item android:offset="1.0" android:color="#FF007F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Accent Audio Particles -->
    <path
        android:pathData="M66,28m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M40,86m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0"
        android:fillColor="#FFFFFF" />

</vector>
